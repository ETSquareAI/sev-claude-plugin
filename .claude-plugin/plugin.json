{
  "name": "sev-by-etsquare-ai",
  "displayName": "SEV — SEC Filing Discovery",
  "version": "0.2.1",
  "description": "Search SEC 10-K and 10-Q filings to find public companies, relevant original passages and available reported financial figures for your research question.",
  "author": {
    "name": "ETSquare AI, LLC",
    "url": "https://etsquare.ai"
  },
  "homepage": "https://etsquare.ai/build",
  "repository": "https://github.com/ETSquareAI/sev-claude-plugin",
  "license": "MIT",
  "keywords": ["SEC", "SEC filings", "EDGAR", "10-K", "10-Q", "annual reports", "quarterly reports", "risk factors", "public companies", "company research", "financial research"],
  "icon": "./assets/sev-app-icon.png",
  "documentationUrl": "https://etsquare.ai/documentation",
  "supportUrl": "https://etsquare.ai/support",
  "privacyPolicyUrl": "https://etsquare.ai/privacy",
  "termsOfServiceUrl": "https://etsquare.ai/terms",
  "userConfig": {
    "sev_api_key": {
      "type": "string",
      "title": "SEV API key",
      "description": "Your SEV API key from https://etsquare.ai/account. It starts with sev_ and is kept in secure storage.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "sev": {
      "type": "http",
      "url": "https://etsquare.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.sev_api_key}"
      }
    }
  }
}
